# Публичные настройки браузерного клиента. Секретов здесь быть не должно.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_API_URL=http://127.0.0.1:54321/functions/v1/public-api
VITE_OWNER_API_URL=http://127.0.0.1:54321/functions/v1/owner-api
VITE_ASSISTANT_API_URL=http://127.0.0.1:54321/functions/v1/assistant
VITE_VAPID_PUBLIC_KEY=
VITE_DEMO_MODE=true

# Только для локальных скриптов публикации. Не начинаются с VITE_ и не попадают в сборку.
