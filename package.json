{
  "name": "detailing-booking-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm tenant:assets && vite build && tsx scripts/build-tenant-shells.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/public-api/index.ts supabase/functions/owner-api/index.ts supabase/functions/assistant/index.ts supabase/functions/notification-dispatch/index.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:functions && pnpm test && pnpm build",
    "tenant:new": "tsx scripts/tenant-new.ts",
    "tenant:validate": "tsx scripts/tenant-validate.ts",
    "tenant:assets": "tsx scripts/tenant-assets.ts",
    "tenant:publish": "tsx scripts/tenant-publish.ts",
    "tenant:verify": "tsx scripts/tenant-verify.ts"
  },
  "dependencies": {
    "@astryxdesign/cli": "0.6.5",
    "@astryxdesign/core": "0.6.5",
    "@astryxdesign/theme-neutral": "0.6.5",
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "0.19.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "liquid-gl": "^3.0.0",
    "openai": "^7.28.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@supabase/cli-windows-x64": "2.119.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "deno-bin": "2.2.7",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@astryxdesign/cli",
      "@astryxdesign/core",
      "deno-bin",
      "esbuild",
      "sharp",
      "supabase"
    ]
  }
}
